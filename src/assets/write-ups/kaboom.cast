[178.152872, "o", "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<title>NUKETOWN // TERMINAL</title>\r\n\r\n<style>\r\n* { box-sizing: border-box; }\r\n\r\nbody {\r\n    margin: 0;\r\n    background: #050805;\r\n    color: #8cff8c;\r\n    font-family: \"Courier New\", monospace;\r\n}\r\n\r\nbody:after {\r\n    content: \"\";\r\n    position: fixed;\r\n    inset: 0;\r\n    pointer-events: none;\r\n    background: repeating-linear-gradient(\r\n        0deg,\r\n        rgba(255,255,255,.025) 0px,\r\n        rgba(255,255,255,.025) 1px,\r\n        transparent 1px,\r\n        transparent 4px\r\n    );\r\n}\r\n\r\n.terminal {\r\n    width: 90%;\r\n    max-width: 1100px;\r\n    margin: 5vh auto;\r\n    border: 1px solid #3d713d;\r\n    box-shadow: 0 0 30px rgba(80,255,80,.08);\r\n}\r\n\r\n.header {\r\n    padding: 18px 22px;\r\n    border-bottom: 1px solid #3d713d;\r\n    display: flex;\r\n    justify-content: space-between;\r\n}\r\n\r\n.logo {\r\n    font-size: 22px;\r\n    letter-spacing: 4px;\r\n}\r\n\r\n.classified {\r\n    color: #ffb347;\r\n    font-size: 12px;\r\n}\r\n\r\n.main {\r\n    padding: 25px;\r\n}\r\n\r\n.status {\r\n    color: #6fa86f;\r\n    margin-bottom: 20px;\r\n}\r\n\r\ntextarea {\r\n    width: 100%;\r\n    height: 180px;\r\n    resize: vertical;\r\n    background: #020402;\r\n    border: 1px solid #3d713d;\r\n    color: #9cff9c;\r\n    padding: 15px;\r\n    font: 14px \"Courier New\", monospace;\r\n    outline: none;\r\n}\r\n\r\ntextarea:focus {\r\n    border-color: #9cff9c;\r\n}\r\n\r\nbutton {\r\n    margin: 12px 0;\r\n    padding: 10px 25px;\r\n    background: transparent;\r\n    color: #9cff9c;\r\n    border: 1px solid #6caa6c;\r\n    font: bold 13px \"Courier New\", monospace;\r\n    cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n    background: #9cff9c;\r\n    color: #050805;\r\n}\r\n\r\n.output {\r\n    min-height: 220px;\r\n    max-height: 400px;\r\n    overflow: auto;\r\n    white-space: pre-wrap;\r\n    background: #020402;\r\n    border: 1px solid #294b29;\r\n    padding: 15px;\r\n}\r\n\r\n.prompt {\r\n    color: #ffb347;\r\n    margin: 8px 0;\r\n}\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"terminal\">\r\n\r\n    <div class=\"header\">\r\n        <div class=\"logo\">NUKETOWN // TERMINAL</div>\r\n        <div class=\"classified\">CLASSIFIED // LEVEL 04</div>\r\n    </div>\r\n\r\n    <div class=\"main\">\r\n\r\n        <div class=\"status\">\r\n            SYSTEM: ONLINE<br>\r\n            DATABASE: CONNECTED<br>\r\n            GRAPHQL: READY\r\n        </div>\r\n\r\n        <div class=\"prompt\">\r\n            NUKETOWN@TERMINAL:~$ QUERY\r\n        </div>\r\n\r\n        <textarea id=\"query\"></textarea>\r\n\r\n        <button onclick=\"executeQuery()\">EXECUTE</button>\r\n\r\n        <div class=\"prompt\">\r\n            NUKETOWN@TERMINAL:~$ OUTPUT\r\n        </div>\r\n\r\n        <pre class=\"output\" id=\"output\">Awaiting query...</pre>\r\n\r\n    </div>\r\n</div>\r\n\r\n<script>\r\nasync function executeQuery() {\r\n\r\n    const query = document.getElementById(\"query\").value;\r\n    const output = document.getElementById(\"output\");\r\n\r\n    output.textContent = \"PROCESSING...\";\r\n\r\n    try {\r\n\r\n        const response = await fetch(\"/graphql.php\", {\r\n            method: \"POST\",\r\n            headers: {\r\n                \"Content-Type\": \"application/json\",\r\n                \"Accept\": \"application/json\"\r\n            },\r\n            body: JSON.stringify({ query: query })\r\n        });\r\n\r\n        const text = await response.text();\r\n\r\n        if (!text.trim()) {\r\n            output.textContent =\r\n                \"SERVER ERROR\\n\\nEmpty response\\nHTTP \" +\r\n                response.status;\r\n            return;\r\n        }\r\n\r\n        try {\r\n            const json = JSON.parse(text);\r\n\r\n            output.textContent =\r\n                JSON.stringify(json, null, 2);\r\n\r\n        } catch (e) {\r\n\r\n            output.textContent =\r\n                \"SERVER RETURNED INVALID JSON\\n\\n\" + text;\r\n        }\r\n\r\n    } catch (e) {\r\n\r\n        output.textContent =\r\n            \"CONNECTION ERROR\\n\\n\" + e.message;\r\n    }\r\n}\r\n</script>\r\n\r\n</body>\r\n</html>\r\n\r\n"]
