[1034.882603, "o", "You’ll find this information useful\r\n\r\nChecking capabilities with getcap:\r\n"]
[1034.901679, "o", "\r\n"]
[1034.902554, "o", "Checking capabilities with capsh:\r\n"]
[1034.910301, "o", "Current: cap_chown,cap_dac_override,cap_fowner,cap_fsetid,cap_kill,cap_setgid,cap_setuid,cap_setpcap,cap_net_bind_service,cap_net_raw,cap_sys_chroot,cap_sys_admin,cap_mknod,cap_audit_write,cap_setfcap=ep"]
