[99.580777, "o", "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>KABOOM</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n\r\n<header class=\"topbar\">\r\n    <div class=\"logo\">KABOOM</div>\r\n    <div class=\"classification\">CLASSIFIED // LEVEL 05</div>\r\n</header>\r\n\r\n<main class=\"container\">\r\n\r\n    <section class=\"hero\">\r\n        <p class=\"terminal-line\">> INITIALIZING ARCHIVE...</p>\r\n        <h1>ZOMBIES // ARCHIVE</h1>\r\n        <p class=\"warning\">UNAUTHORIZED ACCESS WILL BE LOGGED</p>\r\n    </section>\r\n\r\n    <section class=\"panel\">\r\n        <div class=\"panel-title\">ARCHIVE STATUS</div>\r\n\r\n        <div class=\"status-grid\">\r\n            <div>\r\n                <span class=\"label\">PROJECT</span>\r\n                <strong>KABOOM</strong>\r\n            </div>\r\n\r\n            <div>\r\n                <span class=\"label\">STATUS</span>\r\n                <strong class=\"red\">ACTIVE</strong>\r\n            </div>\r\n\r\n            <div>\r\n                <span class=\"label\">THREAT</span>\r\n                <strong class=\"red\">UNKNOWN</strong>\r\n            </div>\r\n\r\n            <div>\r\n                <span class=\"label\">LAST UPDATE</span>\r\n                <strong>19.11.1963</strong>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"panel\">\r\n        <div class=\"panel-title\">FIELD NOTES</div>\r\n\r\n        <p>\r\n            The KABOOM programme was set up to investigate\r\n            anomalous events recorded at various abandoned sites.\r\n        </p>\r\n\r\n        <p>\r\n            The reports mention non-dead activity, military experiments\r\n            and a substance known as <span class=\"green\">Element 115</span>.\r\n        </p>\r\n\r\n        <p class=\"dim\">\r\n            Most of the original documents have been destroyed.\r\n        </p>\r\n    </section>\r\n\r\n    <nav class=\"menu\">\r\n        <a href=\"intel.html\">[ ACCESS INTELLIGENCE FILES ]</a>\r\n        <a href=\"terminal.html\">[ OPEN TERMINAL LOG ]</a>\r\n    </nav>\r\n\r\n    <section class=\"quote\">\r\n        <span>\"</span>\r\n        <p>THEY KEEP COMING.</p>\r\n        <small>— UNKNOWN SURVIVOR</small>\r\n    </section>\r\n\r\n</main>\r\n\r\n<footer>\r\n    KABOOM ARCHIVE SYSTEM // PROPERTY OF CLASSIFIED OPERATIONS\r\n    <br>\r\n    <span>NO SIGNAL // NO RECORD // NO SURVIVORS</span>\r\n</footer>\r\n\r\n</body>\r\n</html>"]
