[327.831437, "o", "\u001b[22A\b\b\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mA\u001b[33mc\u001b[33mc\u001b[33me\u001b[33mp\u001b[33mt\u001b[33m:\u001b[33m \u001b[33ma\u001b[33mp\u001b[33mp\u001b[33ml\u001b[33mi\u001b[33mc\u001b[33ma\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m/\u001b[33mj\u001b[33ms\u001b[33mo\u001b[33mn\u001b[33m'\u001b[39m\u001b[1B\u001b[29D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mA\u001b[33mc\u001b[33mc\u001b[33me\u001b[33mp\u001b[33mt\u001b[33m-\u001b[33mL\u001b[33ma\u001b[33mn\u001b[33mg\u001b[33mu\u001b[33ma\u001b[33mg\u001b[33me\u001b[33m:\u001b[33m \u001b[33me\u001b[33mn\u001b[33m-\u001b[33mU\u001b[33mS\u001b[33m,\u001b[33me\u001b[33mn\u001b[33m;\u001b[33mq\u001b[33m=\u001b[33m0\u001b[33m.\u001b[33m5\u001b[33m'\u001b[39m\u001b[1B\u001b[36D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mA\u001b[33mc\u001b[33mc\u001b[33me\u001b[33mp\u001b[33mt\u001b[33m-\u001b[33mE\u001b[33mn\u001b[33mc\u001b[33mo\u001b[33md\u001b[33mi\u001b[33mn\u001b[33mg\u001b[33m:\u001b[33m \u001b[33mg\u001b[33mz\u001b[33mi\u001b[33mp\u001b[33m,\u001b[33m \u001b[33md\u001b[33me\u001b[33mf\u001b[33ml\u001b[33ma\u001b[33mt\u001b[33me\u001b[33m'\u001b[39m\u001b[1B\u001b[35D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mR\u001b[33me\u001b[33mf\u001b[33me\u001b[33mr\u001b[33me\u001b[33mr\u001b[33m:\u001b[33m \u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33mn\u001b[33mu\u001b[33mk\u001b[33me\u001b[33m-\u001b[33mt\u001b[33mo\u001b[33mw\u001b[33mn\u001b[33m-\u001b[33m5\u001b[33m0\u001b[33m.\u001b[33mk\u001b[33ma\u001b[33mb\u001b[33mo\u001b[33mo\u001b[33mm\u001b[33m.\u001b[33mt\u001b[33mh\u001b[33ml\u001b[33m/\u001b[33m'\u001b[39m\u001b[1B\u001b[45D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mC\u001b[33mo\u001b[33mn\u001b[33mt\u001b[33me\u001b[33mn\u001b[33mt\u001b[33m-\u001b[33mT\u001b[33my\u001b[33mp\u001b[33me\u001b[33m:\u001b[33m \u001b[33ma\u001b[33mp\u001b[33mp\u001b[33ml\u001b[33mi\u001b[33mc\u001b[33ma\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m/\u001b[33mj\u001b[33ms\u001b[33mo\u001b[33mn\u001b[33m'\u001b[39m\u001b[1B\u001b[35D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mO\u001b[33mr\u001b[33mi\u001b[33mg\u001b[33mi\u001b[33mn\u001b[33m:\u001b[33m \u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33mn\u001b[33mu\u001b[33mk\u001b[33me\u001b[33m-\u001b[33mt\u001b[33mo\u001b[33mw\u001b[33mn\u001b[33m-\u001b[33m5\u001b[33m0\u001b[33m.\u001b[33mk\u001b[33ma\u001b[33mb\u001b[33mo\u001b[33mo\u001b[33mm\u001b[33m.\u001b[33mt\u001b[33mh\u001b[33ml\u001b[33m'\u001b[39m\u001b[1B\u001b[43D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mC\u001b[33mo\u001b[33mn\u001b[33mn\u001b[33me\u001b[33mc\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m:\u001b[33m \u001b[33mk\u001b[33me\u001b[33me\u001b[33mp\u001b[33m-\u001b[33ma\u001b[33ml\u001b[33mi\u001b[33mv\u001b[33me\u001b[33m'\u001b[39m\u001b[1B\u001b[27D\u001b[32m-\u001b[32mH\u001b[39m \u001b[33m'\u001b[33mP\u001b[33mr\u001b[33mi\u001b[33mo\u001b[33mr\u001b[33mi\u001b[33mt\u001b[33my\u001b[33m:\u001b[33m \u001b[33mu\u001b[33m=\u001b[33m0\u001b[33m'\u001b[39m\u001b[1B\u001b[18D\u001b[32m-\u001b[32m-\u001b[32md\u001b[32ma\u001b[32mt\u001b[32ma\u001b[32m-\u001b[32mr\u001b[32ma\u001b[32mw\u001b[39m \u001b[33m'\u001b[1m\u001b[34m{\u001b[0m\u001b[39m\u001b[33m\"\u001b[33mq\u001b[33mu\u001b[33me\u001b[33mr\u001b[33my\u001b[33m\"\u001b[33m:\u001b[33m\"\u001b[1m\u001b[32m{\u001b[0m\u001b[39m\u001b[1B\r\u001b[33m \u001b[33m \u001b[33m_\u001b[33m_\u001b[33ms\u001b[33mc\u001b[33mh\u001b[33me\u001b[33mm\u001b[33ma\u001b[33m \u001b[1m\u001b[35m{\u001b[0m\u001b[39m\u001b[1B\r\u001b[33m \u001b[33m \u001b[33m \u001b[33m \u001b[33mq\u001b[33mu\u001b[33me\u001b[33mr\u001b[33my\u001b[33mT\u001b[33my\u001b[33mp\u001b[33me\u001b[33m \u001b[1m\u001b[33m{\u001b[0m\u001b[39m\u001b[1B\r\u001b[33m \u001b[33m \u001b[33m \u001b[33m \u001b[33m \u001b[33m \u001b[33mn\u001b[33ma\