;1m\u001b[31m # Printable ASCII constraints for each byte\u001b[18;3H\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]:\u001b[19;4H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m shift \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [0, 8, 16, 24]:\u001b[20;6Hbyte = Extract(shift+7, shift, var)\u001b[21;6Hs.add(Or(\u001b[22;9HAnd(byte >= 0x20, byte <= 0x7E),\u001b(B\u001b[0;1m\u001b[31m # Printable ASCII\u001b[23;9H\u001b[39m\u001b(B\u001b[mbyte == 0x00\u001b[24;8H\u001b(B\u001b[0;1m\u001b[31m # Allow null padding\u001b[25;6H\u001b[39m\u001b(B\u001b[m))\u001b[26;3H\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m s.check() == sat:\u001b[27;4Hmodel = s.model()\u001b[28;4Hsolution = [model[var].as_long() \u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]]\u001b[29;3H\u001b(B\u001b[0;1m\u001b[31m # Convert to little-endian password string\u001b[30;4H\u001b[39m\u001b(B\u001b[mpassword = bytearray()\u001b[31;4H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m val \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m solution:\u001b[32;6Hpassword += bytes([\u001b[33;7H(val >> 0) & 0xFF,\u001b(B\u001b[0;1m\u001b[31m # Little-endian conversion\u001b[34;7H\u001b[39m\u001b(B\u001b[m(val >> 8) & 0xFF,\u001b[35;7H(val >> 16) & 0xFF,\u001b[36;7H(val >> 24) & 0xFF\r\u001b[2d\u001b[?12l\u001b[?25h"]
