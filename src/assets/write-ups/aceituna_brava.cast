[448.63119, "o", "\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[39md\u001b[39mb\u001b[39m=\u001b[39mn\u001b[39me\u001b[39mw\u001b[39m \u001b[39mm\u001b[39my\u001b[39ms\u001b[39mq\u001b[39ml\u001b[39mi\u001b[39m(\u001b[39m'\u001b[39m1\u001b[39m7\u001b[39m2\u001b[39m.\u001b[39m3\u001b[39m3\u001b[39m.\u001b[39m1\u001b[39m0\u001b[39m.\u001b[39m1\u001b[39m0\u001b[39m'\u001b[39m,\u001b[39m \u001b[39m'\u001b[39mr\u001b[39mo\u001b[39mo\u001b[39mt\u001b[39m'\u001b[39m,\u001b[39m \u001b[39m'\u001b[39mM\u001b[39ms\u001b[39m4\u001b[39m2\u001b[39md\u001b[39m0\u001b[39mM\u001b[39m3\u001b[39mo\u001b[39mW\u001b[39mL\u001b[39mw\u001b[39m'\u001b[39m,\u001b[39m \u001b[39m'\u001b[39mc\u001b[39mh\u001b[39ma\u001b[39mm\u001b[39mi\u001b[39ml\u001b[39mo\u001b[39m_\u001b[39md\u001b[39mb\u001b[39m'\u001b[39m,\u001b[39m \u001b[39m3\u001b[39m3\u001b[39m0\u001b[39m6\u001b[39m)\u001b[39m;\u001b[39mf\u001b[39mo\u001b[39mr\u001b[39me\u001b[39ma\u001b[39mc\u001b[39mh\u001b[39m(\u001b[39m\\\u001b[39m$\u001b[39md\u001b[39mb\u001b[39m-\u001b[39m>\u001b[39mq\u001b[39mu\u001b[39me\u001b[39mr\u001b[39my(\u001b[39m'\u001b[39mS\u001b[39mE\u001b[39mL\u001b[39mE\u001b[39mC\u001b[39mT\u001b[39m \u001b[39m*\u001b[39m \u001b[39mF\u001b[39mR\u001b[39mO\u001b[39mM\u001b[39m \u001b[39mu\u001b[39ms\u001b[39me\u001b[39mr\u001b[39m'\u001b[39m)\u001b[39m \u001b[39ma\u001b[39ms\u001b[39m \u001b[39m\\\u001b[39m$\u001b[39mr\u001b[39mo\u001b[39mw\u001b[39m \u001b[39mp\u001b[39mr\u001b[39mi\u001b[39mn\u001b[39mt\u001b[39m_\u001b[39mr\u001b[39m(\u001b[39m\\\u001b[39m$\u001b[39mr\u001b[39mo\u001b[39mw\u001b[39m)\u001b[39m;\u001b[39m \u001b[39m?\u001b[39m>\u001b[39m\"\u001b[39m \u001b[39m>\u001b[39m \u001b[39mr\u001b[39mc\u001b[39me\u001b[39m2\u001b[39m.\u001b[39mp\u001b[39mh\u001b[39mp"]
[448.631668, "o", "\u001b[A\u001b[44D\u001b[33md\u001b[33mb\u001b[33m=\u001b[33mn\u001b[33me\u001b[33mw\u001b[33m \u001b[33mm\u001b[33my\u001b[33ms\u001b[33mq\u001b[33ml\u001b[33mi\u001b[1m\u001b[34m(\u001b[0m\u001b[39m\u001b[33m'\u001b[33m1\u001b[33m7\u001b[33m2\u001b[33m.\u001b[33m3\u001b[33m3\u001b[33m.\u001b[33m1\u001b[33m0\u001b[33m.\u001b[33m1\u001b[33m0\u001b[33m'\u001b[33m,\u001b[33m \u001b[33m'\u001b[33mr\u001b[33mo\u001b[33mo\u001b[33mt\u001b[33m'\u001b[33m,\u001b[33m \u001b[33m'\u001b[33mM\u001b[33ms\u001b[33m4\u001b[33m2\u001b[33md\u001b[33m0\u001b[33mM\u001b[33m3\u001b[33mo\u001b[33mW\u001b[33mL\u001b[33mw\u001b[33m'\u001b[33m,\u001b[33m \u001b[33m'\u001b[33mc\u001b[33mh\u001b[33ma\u001b[33mm\u001b[33mi\u001b[33ml\u001b[33mo\u001b[33m_\u001b[33md\u001b[33mb\u001b[33m'\u001b[33m,\u001b[33m \u001b[33m3\u001b[33m3\u001b[33m0\u001b[33m6\u001b[1m\u001b[34m)\u001b[0m\u001b[39m\u001b[33m;\u001b[33mf\u001b[33mo\u001b[33mr\u001b[33me\u001b[33ma\u001b[33mc\u001b[33mh\u001b[1m\u001b[31m(\u001b[0m\u001b[39m\u001b[1m\u001b[35m\\\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[33md\u001b[33mb\u001b[33m-\u001b[33m>\u001b[33mq\u001b[33mu\u001b[33me\u001b[33mr\u001b[33my\u001b[1m\u001b[32m(\u001b[0m\u001b[39m\u001b[33m'\u001b[33mS\u001b[33mE\u001b[33mL\u001b[33mE\u001b[33mC\u001b[33mT\u001b[33m \u001b[33m*\u001b[33m \u001b[33mF\u001b[33mR\u001b[33mO\u001b[33mM\u001b[33m \u001b[33mu\u001b[33ms\u001b[33me\u001b[33mr\u001b[33m'\u001b[1m\u001b[32m)\u001b[0m\u001b[39m\u001b[33m \u001b[33ma\u001b[33ms\u001b[33m \u001b[1m\u001b[35m\\\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[33mr\u001b[33mo\u001b[33mw\u001b[33m \u001b[33mp\u001b[33mr\u001b[33mi\u001b[33mn\u001b[33mt\u001b[33m_\u001b[33mr\u001b[1m\u001b[32m(\u001b[0m\u001b[39m\u001b[1m\u001b[35m\\\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[33mr\u001b[33mo\u001b[33mw\u001b[1m\u001b[32m)\u001b[0m\u001b[39m\u001b[33m;\u001b[33m \u001b[33m?\u001b[33m>\u001b[33m\"\u001b[39m \u001b[1m\u001b[34m>\u001b[0m\u001b[39m\u001b[9C"]
