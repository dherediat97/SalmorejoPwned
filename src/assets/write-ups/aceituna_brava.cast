[1484.778185, "o", "\u001b(B\u001b[m\u001b[37;46H\u001b(B\u001b[0;7m[ 43 l\u00edneas le\u00eddas ]\u001b(B\u001b[m\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.7                                        main.py                                                  \u001b[1;110H\u001b(B\u001b[m\r\u001b[38d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Ayuda\u001b[16G\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Guardar     \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Buscar\u001b[46G\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cortar\u001b[61G\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Ejecutar    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Ubicaci\u00f3n   \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Deshacer\r\u001b[39d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Salir\u001b[16G\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Leer fich.  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Reemplazar  \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Pegar\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justificar  \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Ir a l\u00ednea  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Rehacer\r\u001b[2d\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m z3 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m *\r\u001b[4d\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m solve_challenge\u001b[39m\u001b(B\u001b[m():\u001b[5;3Hs = Solver()\r\u001b[6d \u001b(B\u001b[0;1m\u001b[31m # 32-bit variables for each password block\u001b[7;3H\u001b[39m\u001b(B\u001b[mv0, v1, v2, v3, v4, v5 = BitVecs(\u001b(B\u001b[0;1m\u001b[32m'v0 v1 v2 v3 v4 v5'\u001b[39m\u001b(B\u001b[m, 32)\r\u001b[9d \u001b(B\u001b[0;1m\u001b[31m # Original equation constraints\u001b[10;3H\u001b[39m\u001b(B\u001b[ms.add((v0 ^ v1) + LShR(v2, 1) == 0x99A20F13)\u001b[11;3Hs.add((v1 + v3) ^ 0xCAFEBABE == 0x62787F31)\u001b[12;3Hs.add((v4 - v2) ^ v5 == 0xBB7B3331)\u001b[13;3Hs.add(((v0 + v3) << 2) ^ v5 == 0x665001D5)\u001b(B\u001b[0;1m\u001b[31m # 32-bit adjusted\u001b[14;3H\u001b[39m\u001b(B\u001b[ms.add(v1 * 2 + v4 == 0xD8F337B2)\u001b[15;3Hs.add((v0 ^ v2) + LShR(v5, 3) == 0x28FC326E)\r\u001b[17d\u001b(B\u001b[0;1m\u001b[31m # Printable ASCII constraints for each byte\u001b[18;2H\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]:\u001b[19;4H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m shift \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [0, 8, 16, 24]:\u001b[20;6Hbyte = Extract(shift+7, shift, var)\u001b[21;8Hs.add(Or(\u001b[22;8HAnd(byte >= 0x20, byte <= 0x7E),\u001b(B\u001b[0;1m\u001b[31m # Printable ASCII\u001b[23;8H\u001b[39m\u001b(B\u001b[mbyte == 0x00\u001b[24;7H\u001b(B\u001b[0;1m\u001b[31m # Allow null padding\u001b[25;6H\u001b[39m\u001b(B\u001b[m))\r\u001b[26d \u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m s.check() == sat:\u001b[27;4Hmodel = s.model()\u001b[28;4Hsolution = [model[var].as_long() \u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]]\u001b[29;3H\u001b(B\u001b[0;1m\u001b[31m # Convert to little-endian password string\u001b[30;4H\u001b[39m\u001b(B\u001b[mpassword = bytearray()\u001b[31;4H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m val \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m solution:\u001b[32;6Hpassword += bytes([\u001b[33;7H(val >> 0) & 0xFF,\u001b(B\u001b[0;1m\u001b[31m # Little-endian conversion\u001b[34;7H\u001b[39m\u001b(B\u001b[m(val >> 8) & 0xFF,\u001b[35;7H(val >> 16) & 0xFF,\u001b[36;7H(val >> 24) & 0xFF\r\u001b[2d\u001b[?12l\u001b[?25h"]
