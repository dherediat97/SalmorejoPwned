[975.770149, "o", "\u001b[33mr\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m'\u001b[39m\u001b[39m \u001b[33m'\u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33ma\u001b[33mc\u001b[33me\u001b[33mi\u001b[33mt\u001b[33mu\u001b[33mn\u001b[33ma\u001b[33mb\u001b[33mr\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33m.\u001b[33mt\u001b[33mh\u001b[33ml\u001b[33m/\u001b[33mm\u001b[33ma\u001b[33mi\u001b[33mn\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33ml\u001b[33mi\u001b[33mb\u001b[33m/\u001b[33mj\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33ms\u001b[33mc\u001b[33mr\u001b[33mi\u001b[33mp\u001b[33mt\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mu\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mU\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m?\u001b[33ma\u001b[33mc\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m=\u001b[33mp\u001b[33mo\u001b[33ms\u001b[33mt\u001b[33m-\u001b[33mu\u001b[33mn\u001b[33ms\u001b[33mu\u001b[33mp\u001b[33mp\u001b[33mo\u001b[33mr\u001b[33mt\u001b[33me\u001b[33md\u001b[33m'\u001b[39m\u001b[108D"]
[976.153232, "o", "\u001b[33mc\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m'\u001b[39m\u001b[39m \u001b[33m'\u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33ma\u001b[33mc\u001b[33me\u001b[33mi\u001b[33mt\u001b[33mu\u001b[33mn\u001b[33ma\u001b[33mb\u001b[33mr\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33m.\u001b[33mt\u001b[33mh\u001b[33ml\u001b[33m/\u001b[33mm\u001b[33ma\u001b[33mi\u001b[33mn\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33ml\u001b[33mi\u001b[33mb\u001b[33m/\u001b[33mj\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33ms\u001b[33mc\u001b[33mr\u001b[33mi\u001b[33mp\u001b[33mt\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mu\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mU\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m?\u001b[33ma\u001b[33mc\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m=\u001b[33mp\u001b[33mo\u001b[33ms\u001b[33mt\u001b[33m-\u001b[33mu\u001b[33mn\u001b[33ms\u001b[33mu\u001b[33mp\u001b[33mp\u001b[33mo\u001b[33mr\u001b[33mt\u001b[33me\u001b[33md\u001b[33m'\u001b[39m\u001b[108D"]
