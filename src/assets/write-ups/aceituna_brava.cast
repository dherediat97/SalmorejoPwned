[1265.781911, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.7                                        main.py                                                  \u001b[1;110H\u001b(B\u001b[m\r\u001b[38d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Ayuda\u001b[16G\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Guardar     \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Buscar\u001b[46G\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cortar\u001b[61G\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Ejecutar    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Ubicaci\u00f3n   \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Deshacer\r\u001b[39d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Salir\u001b[16G\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Leer fich.  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Reemplazar  \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Pegar\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justificar  \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Ir a l\u00ednea  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Rehacer\r\u001b[2d\u001b[?12l\u001b[?25h"]
