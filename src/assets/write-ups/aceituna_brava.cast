[501.164875, "o", "            <li>[2018-05-08] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/d231d45c20ca6278b2a24cd4a23f4d938fc14a9e\">d231d45c</a>) Global: Fix issue with browser name and \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K detection</li>\r\n            <li>[2018-04-30] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/4c0b6306a5332859a81560b65ced753fb5c86c3c\">4c0b6306</a>) Plugin: Learning calendar: Add header and block pages (initial \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K without plugin)</li>\r\n"]
[501.168802, "o", "            <li>[2018-04-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/8e257a3e7a03b3213f7c0309419a325c720f4d04\">8e257a3e</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2346\">GH#2346</a>) Internal: Add script to switch from get_lang() variables con\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K to gettext-like strings</li>\r\n            <li>[2018-02-16] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/f90ac3c0d59442d86fbdbb7137fe26eb639efc3d\">f90ac3c0</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2380\">GH#2380</a>) Internal: Update ViewerJS library to \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 0.5.8 #2380</li>\r\n    <div class=\"\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K\" aria-label=\"1.11.6\">\r\n    <p><a href=\"https://en.wikipedia.org/wiki/Pozna%C5%84\">Poznán</a> is a city on the Warta river in west-central Poland. It is best known for its renaissance Old Town and Ostrów Tumski Cathedral. Poznań is among the oldest and largest cities in Poland. It has often topped rankings as a city with very high quality of education and a very high standard of living. Giving the stability this 8th anniversary \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 1.11.6 has achieved and its high benefits to education, we believe Poznán is a fitting name for us.</p>\r\n        <li>[2017-07-06] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/33debc5659b286890b53dfd24ada2b699f506449\">33debc56</a> - <a href=\"https://task.beeznest.com/issues/12898\">BT#12898</a>) Admin: Add configuration setting 'score_grade_model' to enable the con\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K of scores to text/color labels using a model if the score is inside those values</li>\r\n"]
[501.173498, "o", "        <li>[2017-12-28] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/c7327e9f622ed59ff3fcf6f4bfbe7995851fc5d1\">c7327e9f</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2214\">GH#2214</a>) Install: Remove minor query blocking migration (intra-\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K)</li>\r\n        <li>[2017-12-26] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/54a53c2d1937d162cf7cf9d443907692c81896d4\">54a53c2d</a>) Changelog: Add \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K index list</li>\r\n        <li>[2017-12-18] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/293a5fb8a511962ec4c98ac469b2c540d3a3c370\">293a5fb8</a>) Internal: Update gaufrette \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K</li>\r\n        <li>[2017-12-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/b2db2fc7a6974a9320e693cb8b37cb2e15b873f7\">b2db2fc7</a>) Plugin: Bump \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K for vChamilo plugin</li>\r\n        <li>[2017-12-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/51c5473217ca1f6aa195c1130d5e89dcacf3fe37\">51c54732</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2140\">GH#2140</a>) Documentation: Bump minimum recommended \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K of MySQL to 5.6</li>\r\n        <li>[2017-11-30] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/db00609ad613f9454b0b7fe03e77355e92044800\">db00609a</a>) Internal: Update chromedriver to \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 2.33</li>\r\n        <li>[2017-11-15] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/1f90bcd0a1e9c8b42fc65097ee45aea1234acec0\">1f90bcd0</a>) Internal: Update mathjax to \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 2.7</li>\r\n"]
[501.173882, "o", "        <li>[2017-10-19] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/caad47cde94bef511b9a01945e8ae5fffb764646\">caad47cd</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2200\">GH#2200</a>) Internal: Bump php-markdown \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K to get the latest syntax fixes</li>"]
