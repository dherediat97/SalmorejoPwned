[1274.910532, "o", "\u001b(B\u001b[0;1m\u001b[31m# Original equation constraints\r\u001b[9d"]
[1274.911034, "o", "\u001b[39m\u001b(B\u001b[ms.add((v0 ^ v1) + LShR(v2, 1) == 0x99A20F13)\r\u001b[10d"]
[1274.91226, "o", "s.add((v1 + v3) ^ 0xCAFEBABE == 0x62787F31)\r\u001b[11d"]
[1274.912536, "o", "s.add((v4 - v2) ^ v5 == 0xBB7B3331)\r\u001b[12d"]
[1274.912805, "o", "s.add(((v0 + v3) << 2) ^ v5 == 0x665001D5)\u001b(B\u001b[0;1m\u001b[31m # 32-bit adjusted\r\u001b[13d"]
[1274.913101, "o", "\u001b[39m\u001b(B\u001b[ms.add(v1 * 2 + v4 == 0xD8F337B2)\r\u001b[14d"]
[1274.913376, "o", "s.add((v0 ^ v2) + LShR(v5, 3) == 0x28FC326E)"]
