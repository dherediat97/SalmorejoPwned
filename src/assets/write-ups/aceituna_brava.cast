[1285.240543, "o", "\u001b[?25l\u001b[2;37r\u001b[37;1H\u001b[6S\u001b[1;39r\u001b[10;1H\u001b(B\u001b[0;1m\u001b[31m# Printable ASCII constraints for each byte\r\u001b[11d\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]:\r\u001b[12d\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m shift \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [0, 8, 16, 24]:\r\u001b[13dbyte = Extract(shift+7, shift, var)\r\u001b[14ds.add(Or(\r\u001b[15dAnd(byte >= 0x20, byte <= 0x7E),\u001b(B\u001b[0;1m\u001b[31m # Printable ASCII\r\u001b[16d\u001b[39m\u001b(B\u001b[mbyte == 0x00\r\u001b[17d\u001b(B\u001b[0;1m\u001b[31m # Allow null padding\r\u001b[18d\u001b[39m\u001b(B\u001b[m))\r\u001b[19d\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m s.check() == sat:\r\u001b[20dmodel = s.model()\r\u001b[21dsolution = [model[var].as_long() \u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m var \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m [v0, v1, v2, v3, v4, v5]]\r\u001b[22d\u001b(B\u001b[0;1m\u001b[31m# Convert to little-endian password string\r\u001b[23d\u001b[39m\u001b(B\u001b[mpassword = bytearray()\r\u001b[24d\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m val \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m solution:\r\u001b[25dpassword += bytes([\r\u001b[26d(val >> 0) & 0xFF,\u001b(B\u001b[0;1m\u001b[31m # Little-endian conversion\r\u001b[27d\u001b[39m\u001b(B\u001b[m(val >> 8) & 0xFF,\r\u001b[28d(val >> 16) & 0xFF,\r\u001b[29d(val >> 24) & 0xFF\r\u001b[30d])\r\u001b[31d\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m password.decode(\u001b(B\u001b[0;1m\u001b[32m'utf-8'\u001b[39m\u001b(B\u001b[m, errors=\u001b(B\u001b[0;1m\u001b[32m'ignore'\u001b[39m\u001b(B\u001b[m).strip(\u001b(B\u001b[0;1m\u001b[32m'\u001b(B\u001b[0m\u001b[38;5;148m\\x00\u001b(B\u001b[0;1m\u001b[32m'\u001b[39m\u001b(B\u001b[m)\r\u001b[32d\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\r\u001b[33d\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m\"No solution found\"\r\u001b[34d\u001b[36mif\u001b[39m\u001b(B\u001b[m __name__ == \u001b(B\u001b[0;1m\u001b[32m\"__main__\"\u001b[39m\u001b(B\u001b[m:\r\u001b[35dpassword = solve_challenge()\r\u001b[36dprint(f\u001b(B\u001b[0;1m\u001b[32m\"Valid password: {password}\"\u001b[39m\u001b(B\u001b[m)\u001b[?12l\u001b[?25h"]
