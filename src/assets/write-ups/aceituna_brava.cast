[633.68703, "o", "\u001b[39mk\u001b[39m \u001b[39m'\u001b[39ml\u001b[39me\u001b[39mn\u001b[39mg\u001b[39mt\u001b[39mh\u001b[39m(\u001b[39m$\u001b[39m0\u001b[39m)\u001b[39m \u001b[39m>\u001b[39m=\u001b[39m \u001b[39m5\u001b[39m \u001b[39m&\u001b[39m&\u001b[39m \u001b[39mg\u001b[39ms\u001b[39mu\u001b[39mb\u001b[39m(\u001b[39m/\u001b[39m[\u001b[39m0\u001b[39m-\u001b[39m9\u001b[39m]\u001b[39m/\u001b[39m,\u001b[39m \u001b[39m\"\u001b[39m&\u001b[39m\"\u001b[39m)\u001b[39m \u001b[39m>\u001b[39m=\u001b[39m2\u001b[39m \u001b[39m&\u001b[39m&\u001b[39m \u001b[39m$\u001b[39m0\u001b[39m \u001b[39m~\u001b[39m \u001b[39m/\u001b[39m[\u001b[39m^\u001b[39ma\u001b[39m-\u001b[39mz\u001b[39mA\u001b[39m-\u001b[39mZ\u001b[39m0\u001b[39m-\u001b[39m9\u001b[39m]\u001b[39m/\u001b[39m'\u001b[39m \u001b[39m/\u001b[39mu\u001b[39ms\u001b[39mr\u001b[39m/\u001b[39ms\u001b[39mh\u001b[39ma\u001b[39mr\u001b[39me\u001b[39m/\u001b[39mw\u001b[39mo\u001b[39mr\u001b[39md\u001b[39ml\u001b[39mi\u001b[39ms\u001b[39mt\u001b[39ms\u001b[39m/\u001b[39mr\u001b[39mo\u001b[39mc\u001b[39mk\u001b[39my\u001b[39mo\u001b[39mu\u001b[39m.\u001b[39mt\u001b[39mx\u001b[39mt\u001b[39m \u001b[39m>\u001b[39m \u001b[39mch\u001b[39ma\u001b[39mm\u001b[39mi\u001b[39ml\u001b[39mo\u001b[39m.\u001b[39mt\u001b[39mx\u001b[39mt"]
[633.69595, "o", "\u001b[A\b\b\b\b\b\b\u001b[24m\u001b[36ma\u001b[24m\u001b[36mw\u001b[36mk\u001b[39m \u001b[33m'\u001b[33ml\u001b[33me\u001b[33mn\u001b[33mg\u001b[33mt\u001b[33mh\u001b[1m\u001b[34m(\u001b[0m\u001b[39m\u001b[33m$\u001b[33m0\u001b[1m\u001b[34m)\u001b[0m\u001b[39m\u001b[33m \u001b[33m>\u001b[33m=\u001b[33m \u001b[33m5\u001b[33m \u001b[33m&\u001b[33m&\u001b[33m \u001b[33mg\u001b[33ms\u001b[33mu\u001b[33mb\u001b[1m\u001b[34m(\u001b[0m\u001b[39m\u001b[33m/\u001b[1m\u001b[32m[\u001b[0m\u001b[39m\u001b[33m0\u001b[33m-\u001b[33m9\u001b[1m\u001b[32m]\u001b[0m\u001b[39m\u001b[33m/\u001b[33m,\u001b[33m \u001b[33m\"\u001b[33m&\u001b[33m\"\u001b[1m\u001b[34m)\u001b[0m\u001b[39m\u001b[33m \u001b[33m>\u001b[33m=\u001b[33m2\u001b[33m \u001b[33m&\u001b[33m&\u001b[33m \u001b[33m$\u001b[33m0\u001b[33m \u001b[33m~\u001b[33m \u001b[33m/\u001b[1m\u001b[34m[\u001b[0m\u001b[39m\u001b[33m^\u001b[33ma\u001b[33m-\u001b[33mz\u001b[33mA\u001b[33m-\u001b[33mZ\u001b[33m0\u001b[33m-\u001b[33m9\u001b[1m\u001b[34m]\u001b[0m\u001b[39m\u001b[33m/\u001b[33m'\u001b[39m \u001b[1m/\u001b[1mu\u001b[1ms\u001b[1mr\u001b[1m/\u001b[1ms\u001b[1mh\u001b[1ma\u001b[1mr\u001b[1me\u001b[1m/\u001b[1mw\u001b[1mo\u001b[1mr\u001b[1md\u001b[1ml\u001b[1mi\u001b[1ms\u001b[1mt\u001b[1ms\u001b[1m/\u001b[1mr\u001b[1mo\u001b[1mc\u001b[1mk\u001b[1my\u001b[1mo\u001b[1mu\u001b[1m.\u001b[1mt\u001b[1mx\u001b[1mt\u001b[0m \u001b[1m\u001b[34m>\u001b[0m\u001b[39m\u001b[1B\u001b[99D"]
