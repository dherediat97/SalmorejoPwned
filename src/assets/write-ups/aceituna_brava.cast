t_create' => [\r\n        'http' => [\r\n            'proxy' => 'tcp://example.com:8080',\r\n            'request_fulluri' => true\r\n        ]\r\n    ],\r\n    'curl_setopt_array' => [\r\n        'CURLOPT_PROXY' => 'http://example.com',\r\n        'CURLOPT_PROXYPORT' => '8080'\r\n    ]\r\n];*/\r\n\r\n// E-"]
