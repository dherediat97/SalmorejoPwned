[384.049995, "o", "\r\n      <li>Bert Vanderkimpen (bert.vanderkimpen@ugent.be)</li>\r\n"]
[384.050281, "o", "      <li>Toon Van Hoecke (toon.vanhoecke@UGent.be) </li>\r\n      <li>René Haentjens (rene.haentjens@intec.ugent.be)</li>"]
[384.050611, "o", "\r\n    </ul>\r\n    </li>"]
