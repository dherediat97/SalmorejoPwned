[501.189243, "o", "        <li>[2017-10-09] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/d8de9cc97ed33f5b5e097c2d108ed844fd588931\">d8de9cc9</a>) Internal: Downgrade CKeditor to \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 4.6.2 due to error with copy and paste from Word</li>\r\n        <li>[2017-09-08] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/df424a65e2ef681eb45477a80f5244b07dc50b6c\">df424a65</a> - <a href=\"https://task.beeznest.com/issues/13244\">BT#13244</a>) Calendar: Fix group agenda list from migrated \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K</li>\r\n        <li>[2017-09-08] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/1d5f86b436c0467006a0e0d2f75728d587d45efd\">1d5f86b4</a> - <a href=\"https://task.beeznest.com/issues/13244\">BT#13244</a>) Calendar: Fix group agenda from migrated \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K</li>\r\n        <li>[2017-08-21] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/45c42a6fe7dbcfeb9ec71b49472e00b2be6abe64\">45c42a6f</a>) Internal: Fix pChart issue with custom colors palette with PHP 7.1 - Bump pChart \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K to 3.0.4</li>\r\n        <li>[2017-08-09] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/90200fbb4743616fc85920935e1aec8df0dfa11d\">90200fbb</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/2105\">GH#2105</a>) CSS: Temporarily add missing icons - These will be removed in a future \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K when getting completely rid of .gif icons - fix #2105</li>\r\n"]
[501.189618, "o", "        <li>[2017-07-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/e662b1eec5ae1651aed2dc9e57c6d1b1ecd0c903\">e662b1ee</a>) Internal: Update icalcreator lib \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K dependency</li>"]
