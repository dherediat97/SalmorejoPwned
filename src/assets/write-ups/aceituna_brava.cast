[682.194468, "o", "\u001b[39m \u001b[39m'\u001b[39mb\u001b[39mi\u001b[39mg\u001b[39mU\u001b[39mp\u001b[39ml\u001b[39mo\u001b[39ma\u001b[39md\u001b[39mF\u001b[39mi\u001b[39ml\u001b[39me\u001b[39m=\u001b[39m@\u001b[39ms\u001b[39mq\u001b[39ml\u001b[39m.\u001b[39mp\u001b[39mh\u001b[39mp\u001b[39m'\u001b[39m \u001b[39m'\u001b[39mh\u001b[39mt\u001b[39mt\u001b[39mp\u001b[39m:\u001b[39m/\u001b[39m/\u001b[39ma\u001b[39mc\u001b[39me\u001b[39mi\u001b[39mt\u001b[39mu\u001b[39mn\u001b[39ma\u001b[39mb\u001b[39mr\u001b[39ma\u001b[39mv\u001b[39ma\u001b[39m.\u001b[39mt\u001b[39mh\u001b[39ml\u001b[39m/\u001b[39mm\u001b[39ma\u001b[39mi\u001b[39mn\u001b[39m/\u001b[39mi\u001b[39mn\u001b[39mc\u001b[39m/\u001b[39ml\u001b[39mi\u001b[39mb\u001b[39m/\u001b[39mj\u001b[39ma\u001b[39mv\u001b[39ma\u001b[39ms\u001b[39mc\u001b[39mr\u001b[39mi\u001b[39mp\u001b[39mt\u001b[39m/\u001b[39mb\u001b[39mi\u001b[39mg\u001b[39mu\u001b[39mp\u001b[39ml\u001b[39mo\u001b[39ma\u001b[39md\u001b[39m/\u001b[39mi\u001b[39mn\u001b[39mc\u001b[39m/\u001b[39mb\u001b[39mi\u001b[39mg\u001b[39mU\u001b[39mp\u001b[39ml\u001b[39mo\u001b[39ma\u001b[39md\u001b[39m.\u001b[39mp\u001b[39mh\u001b[39mp\u001b[39m?\u001b[39ma\u001b[39mc\u001b[39mt\u001b[39mi\u001b[39mo\u001b[39mn\u001b[39m=\u001b[39mp\u001b[39mo\u001b[39ms\u001b[39mt\u001b[39m-\u001b[39mu\u001b[39mn\u001b[39ms\u001b[39mu\u001b[39mp\u001b[39mp\u001b[39mo\u001b[39mr\u001b[39mt\u001b[39me\u001b[39md\u001b[39m'"]
