[409.38334, "o", "\u001b[A\u001b[16D\u001b[36mc\u001b[36mu\u001b[36mr\u001b[36ml\u001b[39m \u001b[32m-\u001b[32mF\u001b[39m \u001b[33m'\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mU\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33mF\u001b[33mi\u001b[33ml\u001b[33me\u001b[33m=\u001b[33m@\u001b[33mr\u001b[33mc\u001b[33me\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m'\u001b[39m \u001b[33m'\u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33m1\u001b[33m0\u001b[33m.\u001b[33m0\u001b[33m.\u001b[33m2\u001b[33m.\u001b[33m2\u001b[33m6\u001b[33m/\u001b[33mm\u001b[33ma\u001b[33mi\u001b[33mn\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33ml\u001b[33mi\u001b[33mb\u001b[33m/\u001b[33mj\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33ms\u001b[33mc\u001b[33mr\u001b[33mi\u001b[33mp\u001b[33mt\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mu\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m/\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mU\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m?\u001b[33ma\u001b[33mc\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m=\u001b[33mp\u001b[33mo\u001b[33ms\u001b[33mt\u001b[33m-\u001b[33mu\u001b[33mn\u001b[33ms\u001b[33mu\u001b[33mp\u001b[33mp\u001b[33mo\u001b[33mr\u001b[33mt\u001b[33me\u001b[33md\u001b[33m'\u001b[39m"]
[409.604286, "o", "\u001b[A\u001b[16D\u001b[36me\u001b[36mc\u001b[36mh\u001b[36mo\u001b[39m \u001b[32m\"\u001b[32m<\u001b[39m?\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m \u001b[33me\u001b[33mc\u001b[33mh\u001b[33mo\u001b[33m \u001b[33mf\u001b[33mi\u001b[33ml\u001b[33me\u001b[33m_\u001b[33mg\u001b[33me\u001b[33mt\u001b[33m_\u001b[33mc\u001b[33mo\u001b[33mn\u001b[33mt\u001b[33me\u001b[33mn\u001b[39mt\u001b[33ms\u001b[33m(\u001b[33m'\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33m.\u001b[33m.\u001b[33m/\u001b[33ma\u001b[33mp\u001b[33mp\u001b[33m/\u001b[33mc\u001b[33mo\u001b[33mn\u001b[33mf\u001b[33mi\u001b[33mg\u001b[33m/\u001b[33mc\u001b[33mo\u001b[33mn\u001b[33mf\u001b[33mi\u001b[33mg\u001b[33mu\u001b[33mr\u001b[33ma\u001b[33mt\u001b[33mi\u001b[33mo\u001b[33mn\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[33m'\u001b[33m)\u001b[33m;\u001b[33m \u001b[33m?\u001b[33m>\u001b[33m\"\u001b[33m \u001b[33m>\u001b[33m \u001b[33mr\u001b[33mc\u001b[33me\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[39m\u001b[K\u001b[1B\r\u001b[K\u001b[A\u001b[103C"]
