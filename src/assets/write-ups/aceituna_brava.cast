[330.148855, "o", "\u001b[39mr\u001b[39me\u001b[39ma\u001b[39mc\u001b[39mh\u001b[39m(\u001b[39ma\u001b[39mr\u001b[39mr\u001b[39ma\u001b[39my\u001b[39m_\u001b[39md\u001b[39mi\u001b[39mf\u001b[39mf\u001b[39m(\u001b[39ms\u001b[39mc\u001b[39ma\u001b[39mn\u001b[39md\u001b[39mi\u001b[39mr\u001b[39m(\u001b[39m'\u001b[39m.\u001b[39m'\u001b[39m)\u001b[39m,\u001b[39m \u001b[39m[\u001b[39m'\u001b[39m.\u001b[39m'\u001b[39m,\u001b[39m'\u001b[39m.\u001b[39m.\u001b[39m'\u001b[39m]\u001b[39m)\u001b[39m \u001b[39ma\u001b[39ms\u001b[39m \u001b[39m\\\u001b[39m$\u001b[39ma\u001b[39mr\u001b[39mc\u001b[39mh\u001b[39mi\u001b[39mv\u001b[39mo\u001b[39m)\u001b[39m \u001b[39me\u001b[39mc\u001b[39mh\u001b[39mo\u001b[39m \u001b[39m\\\u001b[39m$\u001b[39ma\u001b[39mr\u001b[39mc\u001b[39mh\u001b[39mi\u001b[39mv\u001b[39mo\u001b[39m \u001b[39m.\u001b[39m \u001b[39m'\u001b[39m<\u001b[39mb\u001b[39mr\u001b[39m>\u001b[39m'\u001b[39m;\u001b[39m \u001b[39m?\u001b[39m>\u001b[39m\"\u001b[39m \u001b[39m>\u001b[39m \u001b[39mr\u001b[39mc\u001b[39me\u001b[39m.\u001b[39mph\u001b[39mp"]
[330.155445, "o", "\u001b[A\u001b[15C\u001b[33mo\u001b[33mr\u001b[33me\u001b[33ma\u001b[33mc\u001b[33mh\u001b[1m\u001b[34m(\u001b[0m\u001b[39m\u001b[33ma\u001b[33mr\u001b[33mr\u001b[33ma\u001b[33my\u001b[33m_\u001b[33md\u001b[33mi\u001b[33mf\u001b[33mf\u001b[1m\u001b[32m(\u001b[0m\u001b[39m\u001b[33ms\u001b[33mc\u001b[33ma\u001b[33mn\u001b[33md\u001b[33mi\u001b[33mr\u001b[1m\u001b[35m(\u001b[0m\u001b[39m\u001b[33m'\u001b[33m.\u001b[33m'\u001b[1m\u001b[35m)\u001b[0m\u001b[39m\u001b[33m,\u001b[33m \u001b[1m\u001b[35m[\u001b[0m\u001b[39m\u001b[33m'\u001b[33m.\u001b[33m'\u001b[33m,\u001b[33m'\u001b[33m.\u001b[33m.\u001b[33m'\u001b[1m\u001b[35m]\u001b[0m\u001b[39m\u001b[1m\u001b[32m)\u001b[0m\u001b[39m\u001b[33m \u001b[33ma\u001b[33ms\u001b[33m \u001b[1m\u001b[35m\\\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[33ma\u001b[33mr\u001b[33mc\u001b[33mh\u001b[33mi\u001b[33mv\u001b[33mo\u001b[1m\u001b[34m)\u001b[0m\u001b[39m\u001b[33m \u001b[33me\u001b[33mc\u001b[33mh\u001b[33mo\u001b[33m \u001b[1m\u001b[35m\\\u001b[1m\u001b[35m$\u001b[0m\u001b[39m\u001b[33ma\u001b[33mr\u001b[33mc\u001b[33mh\u001b[33mi\u001b[33mv\u001b[33mo\u001b[33m \u001b[33m.\u001b[33m \u001b[33m'\u001b[33m<\u001b[33mb\u001b[33mr\u001b[33m>\u001b[33m'\u001b[33m;\u001b[33m \u001b[33m?\u001b[33m>\u001b[33m\"\u001b[39m \u001b[1m\u001b[34m>\u001b[0m\u001b[39m\u001b[1B\u001b[103D"]
