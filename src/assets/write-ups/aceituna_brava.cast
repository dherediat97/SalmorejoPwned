[501.081004, "o", "\r\n        $('.\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K').each(function() {\r\n          var \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K = $(this).attr('aria-label');\r\n            \"href\": \"#\"+\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K\r\n    complete, detailed list of changes for the 1.11 and previous \u001b[01;31m\u001b[Kversion\u001b[m\u001b[Ks on\r\n    \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K by \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K, latest \u001b[01;31m\u001b[Kversion\u001b[m\u001b[Ks first, and should helps you locate when\r\n    please check our \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K releases announcements on our website:\r\n    <div class=\"\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K\" aria-label=\"1.11.24\">\r\n            <li>[2023-08-03] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/62a887f4dd936e4a43fbcf7c791afc5d5246e0e8\">62a887f4</a>) Internal: Set strict requirement for PHP \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 7.4</li>\r\n"]
[501.081387, "o", "    <div class=\"\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K\" aria-label=\"1.11.22\">"]
[501.081598, "o", "\r\n"]
[501.082115, "o", "            <li>[2023-07-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/4b5402edd3bf023215603820aa2ad168fefaef36\">4b5402ed</a> - <a href=\"https://task.beeznest.com/issues/20856\">BT#20856</a>) Plugin: file missing for Fix Stripe process to work with new API \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 2022-11-15</li>\r\n            <li>[2023-07-05] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/91680c781dcb8515748aa3dc05c70982f1a9154a\">91680c78</a> - <a href=\"https://task.beeznest.com/issues/20856\">BT#20856</a>) Plugin: Fix Stripe process to work with new API \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 2022-11-15</li>\r\n"]
[501.08254, "o", "    <div class=\"\u001b[01;31m\u001b[Kversion\u001b[m\u001b[K\" aria-label=\"1.11.20\">\r\n        Chamilo. This \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K being one that would not necessarily have existed would surprising events not happened at\r\n        the time. This \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K matches the appearance of incredible progress in the AI world which have impacted Chamilo\r\n"]
[501.082973, "o", "            <li>[2023-06-02] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/aecd5c724ea28324ef366326fbd74c2349aba741\">aecd5c72</a> - <a href=\"https://github.com/chamilo/chamilo-lms/issues/4639\">GH#4639</a>) Plugin: OnlyOffice: Bump plugin to \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 1.2.0 (adds support for Forms and JWT)</li>\r\n"]
[501.083339, "o", "            <li>[2023-05-25] (<a href=\"https://github.com/chamilo/chamilo-lms/commit/d079f0b80462b85b7ca0c3d54ed6fc450e2a1274\">d079f0b8</a> - <a href=\"https://task.beeznest.com/issues/20674\">BT#20674</a>) System: Security: indication on how to fix an apache since problem present since \u001b[01;31m\u001b[Kversion\u001b[m\u001b[K 2.4.38-3 with rediction of URL with spaces not working any more</li>"]
