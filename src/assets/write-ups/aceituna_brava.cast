[1028.855343, "o", "\u001b[36mc\u001b[36mu\u001b[36mr\u001b[36ml\u001b[39m \u001b[33mh\u001b[33mt\u001b[33mt\u001b[33mp\u001b[33m:\u001b[33m/\u001b[33m/\u001b[33ma\u001b[33mc\u001b[33me\u001b[33mi\u001b[33mt\u001b[33mu\u001b[33mn\u001b[33ma\u001b[33mb\u001b[33mr\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33m.\u001b[33mt\u001b[33mh\u001b[33ml\u001b[33m/\u001b[33mm\u001b[33ma\u001b[33mi\u001b[33mn\u001b[1m\u001b[34m/\u001b[0m\u001b[39m\u001b[33mi\u001b[33mn\u001b[33mc\u001b[33m/\u001b[33ml\u001b[33mi\u001b[33mb\u001b[33m/\u001b[33mj\u001b[33ma\u001b[33mv\u001b[33ma\u001b[33ms\u001b[33mc\u001b[33mr\u001b[33mi\u001b[33mp\u001b[33mt\u001b[33m/\u001b[33mb\u001b[33mi\u001b[33mg\u001b[33mu\u001b[33mp\u001b[33ml\u001b[33mo\u001b[33ma\u001b[33md\u001b[33m/\u001b[33mf\u001b[33mi\u001b[33ml\u001b[33me\u001b[33ms\u001b[33m/\u001b[33mr\u001b[33mc\u001b[33me\u001b[33m2\u001b[33m.\u001b[33mp\u001b[33mh\u001b[33mp\u001b[39m\u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[0m\u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m  \u001b[0m\u001b[39m  \u001b[0m \u001b[0m \u001b[0m \u001b[0m \u001b[0m \u001b[0m \u001b[0m \u001b[0m \u001b[1B\r\u001b[K\u001b[A\u001b[82C\u001b[73D\u001b[39mh\u001b[39mt\u001b[39mt\u001b[39mp\u001b[39m:\u001b[39m/\u001b[39m/\u001b[39ma\u001b[39mc\u001b[39me\u001b[39mi\u001b[39mt\u001b[39mu\u001b[39mn\u001b[39ma\u001b[39mb\u001b[39mr\u001b[39ma\u001b[39mv\u001b[39ma\u001b[39m.\u001b[39mt\u001b[39mh\u001b[39ml\u001b[39m/\u001b[39mm\u001b[39ma\u001b[39mi\u001b[39mn\u001b[0m\u001b[39m/\u001b[39mi\u001b[39mn\u001b[39mc\u001b[39m/\u001b[39ml\u001b[39mi\u001b[39mb\u001b[39m/\u001b[39mj\u001b[39ma\u001b[39mv\u001b[39ma\u001b[39ms\u001b[39mc\u001b[39mr\u001b[39mi\u001b[39mp\u001b[39mt\u001b[39m/\u001b[39mb\u001b[39mi\u001b[39mg\u001b[39mu\u001b[39mp\u001b[39ml\u001b[39mo\u001b[39ma\u001b[39md\u001b[39m/\u001b[39mf\u001b[39mi\u001b[39ml\u001b[39me\u001b[39ms\u001b[39m/\u001b[39mr\u001b[39mc\u001b[39me\u001b[39m2\u001b[39m.\u001b[39mp\u001b[39mh\u00