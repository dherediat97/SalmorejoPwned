[107.910816, "o", "<!DOCTYPE html>\r\r\n<html lang=\"es\">\r\r\n<head>\r\r\n<meta charset=\"utf-8\" />\r\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\r\n<title>Soporte interno · El Guanche Security</title>\r\r\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\r\r\n<style>\r\r\n:root{--bg:#0E1419;--panel:#161E27;--panel-2:#1C2733;--line:#26333F;--signal:#3DDC84;--blue:#4A9FE0;--text:#E4EAF0;--muted:#7C8B9A;--amber:#E0A93D;--red:#E0433D}\r\r\n*{margin:0;padding:0;box-sizing:border-box}\r\r\nbody{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.6}\r\r\na{color:inherit;text-decoration:none}\r\r\n.container{max-width:920px;margin:0 auto;padding:0 26px}\r\r\nheader{background:var(--panel);border-bottom:1px solid var(--line)}\r\r\n.nav{display:flex;align-items:center;justify-content:space-between;height:66px}\r\r\n.brand{display:flex;align-items:center;gap:11px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.15rem}\r\r\n.brand .dot{width:8px;height:8px;border-radius:50%;background:var(--signal);box-shadow:0 0 8px var(--signal)}\r\r\n.brand b{color:var(--signal)}\r\r\n.nav a{font-size:0.9rem;color:var(--muted)}\r\r\n.wrap{padding:54px 0}\r\r\n.eyebrow{font-family:'Space Grotesk',monospace;font-size:0.8rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--blue);margin-bottom:12px}\r\r\nh1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.9rem;letter-spacing:-0.02em;margin-bottom:10px}\r\r\n.lead{color:var(--muted);margin-bottom:14px}\r\r\n.warn{background:rgba(224,169,61,0.08);border:1px solid rgba(224,169,61,0.3);border-left:3px solid var(--amber);border-radius:0 8px 8px 0;padding:12px 16px;font-size:0.9rem;color:#E0C98A;margin-bottom:34px}\r\r\n.ticket{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:0;margin-bottom:20px;overflow:hidden}\r\r\n.ticket-head{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--line);background:var(--panel-2)}\r\r\n.ticket-id{font-family:'Space Grotesk',monospace;font-size:0.86rem;color:var(--blue)}\r\r\n.badge{font-size:0.74rem;padding:3px 10px;border-radius:100px;font-weight:600;letter-spacing:0.03em}\r\r\n.badge.open{background:rgba(224,67,61,0.15);color:#F08983}\r\r\n.badge.resolved{background:rgba(61,220,132,0.12);color:var(--signal)}\r\r\n.badge.progress{background:rgba(224,169,61,0.14);color:#E0C98A}\r\r\n.ticket-body{padding:18px 20px}\r\r\n.ticket-body .subj{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:1.02rem;margin-bottom:10px}\r\r\n.ticket-body p{font-size:0.94rem;color:var(--muted);margin-bottom:8px}\r\r\n.ticket-meta{display:flex;gap:18px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line);font-size:0.82rem;color:var(--muted)}\r\r\n.ticket-meta b{color:var(--text);font-weight:500}\r\r\ncode{font-family:'Space Grotesk',monospace;background:var(--panel-2);padding:2px 7px;border-radius:5px;color:var(--signal);font-size:0.88em}\r\r\n.foot{margin-top:30px;font-size:0.84rem;color:var(--muted)}\r\r\n</style>\r\r\n</head>\r\r\n<body>\r\r\n<header>\r\r\n  <div class=\"container nav\">\r\r\n    <div class=\"brand\"><span class=\"dot\"></span>El Guanche <b>Security</b></div>\r\r\n    <a href=\"../index.html\">← Volver al sitio</a>\r\r\n  </div>\r\r\n</header>\r\r\n\r\r\n<div class=\"wrap\">\r\r\n  <div class=\"container\">\r\r\n    <div class=\"eyebrow\">Sistema interno de tickets</div>\r\r\n    <h1>Soporte técnico</h1>\r\r\n    <p class=\"lead\">Registro de incidencias de la central de videovigilancia.</p>\r\r\n    <div class=\"warn\">⚠ Página de uso interno. No debería ser accesible desde el exterior — pendiente de mover tras el portal autenticado (ver ticket #4471).</div>\r\r\n\r\r\n    <div class=\"ticket\">\r\r\n      <div class=\"ticket-head\"><span class=\"ticket-id\">#4468</span><span class=\"badge progress\">EN CURSO</span></div>\r\r\n      <div class=\"ticket-body\">\r\r\n        <div class=\"subj\">La API de diagnóstico expone datos de más</div>\r\r\n        <p>El endpoint de diagnóstico del servicio de cámaras (puerto 8080) está devolviendo información del sistema "]
[107.911412, "o", "sin autenticación, incluida la cuenta de servicio con la que corre la aplicación. Habría que revisar qué campos se están exponiendo en <code>/api/diagnostics.json</code>.</p>\r\r\n        <div class=\"ticket-meta\"><span>Abierto por: <b>Guacimara</b></span><span>Asignado a: <b>Bencomo</b></span><span>Prioridad: <b>Media</b></span></div>\r\r\n      </div>\r\r\n    </div>\r\r\n\r\r\n    <div class=\"ticket\">\r\r\n      <div class=\"ticket-head\"><span class=\"ticket-id\">#4470</span><span class=\"badge open\">ABIERTO</span></div>\r\r\n      <div class=\"ticket-body\">\r\r\n        <div class=\"subj\">Reinicio del servicio de cámaras</div>\r\r\n        <p>Cuando los sensores de alguna cámara dejan de responder, el servicio hay que reiniciarlo a mano. Rayco dejó un script de mantenimiento en el recurso compartido de soporte para no depender de que esté yo. Recordad que la cuenta que usa el script es la de servicio, no la vuestra.</p>\r\r\n        <div class=\"ticket-meta\"><span>Abierto por: <b>Rayco</b></span><span>Asignado a: <b>Tanausú</b></span><span>Prioridad: <b>Baja</b></span></div>\r\r\n      </div>\r\r\n    </div>\r"]
[107.911831, "o", "\r\n"]
[107.91212, "o", "\r\r\n"]
[107.912398, "o", "    <div class=\"ticket\">\r\r\n"]
[107.91275, "o", "      <div class=\"ticket-head\"><span class=\"ticket-id\">#4471</span><span class=\"badge open\">ABIERTO</span></div>\r\r\n"]
[107.921042, "o", "      <div class=\"ticket-body\">\r\r\n        <div class=\"subj\">Mover esta página de tickets tras el login</div>\r\r\n        <p>El listado de tickets es accesible sin autenticar. Hay que moverlo detrás del portal de clientes antes de que lo vea quien no debe. Lo dejo apuntado para no olvidarlo.</p>\r\r\n        <div class=\"ticket-meta\"><span>Abierto por: <b>Tanausú</b></span><span>Asignado a: <b>Tanausú</b></span><span>Prioridad: <b>Alta</b></span></div>\r\r\n      </div>\r\r\n    </div>\r\r\n\r\r\n"]
[107.921134, "o", "    <div class=\"foot\">Sistema de tickets · El Guanche Security S.L. · uso interno</div>\r\r\n  </div>\r\r\n</div>\r\r\n</body>\r\r\n</html>\r\r\n"]
